# Secrets and local configuration
.env
.env.*
!.env.example

# Dependencies
node_modules/
npm-debug.log*

# Runtime state, not source: the JSON store, generated emails and uploaded evidence
data/
backups/

# Throwaway browser profiles created by the e2e suites (these reach gigabytes)
tests/.*/
tests/*-edge-*/
tests/qa-*/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp

# Working copies of the store made while debugging. These hold real uploaded
# documents — payment proofs, donation receipts, business logos, CVs — so they
# must never reach the repository.
data-*/
.tmp-*/
*.log
