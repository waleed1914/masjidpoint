NODE_ENV=production
PORT=4173
DATABASE_URL=postgresql://user:password@host:5432/masjidpoint
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_REGION=eu-west-2
OBJECT_STORAGE_BUCKET=masjidpoint-private
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SSE=AES256
BACKUP_ENCRYPTION_KEY=
APP_BASE_URL=https://your-domain.example
EMAIL_FROM=MasjidPoint <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_VERIFY=true
